# dpo-agent web — environment variables
#
# Copy this file to .env and fill in the values. The .env file
# is loaded by docker compose automatically.
#
# DO NOT commit your .env file to git (it has secrets).

# ─── LLM provider credentials (one of these is required) ─────────────
# At least one of ANTHROPIC_API_KEY, OPENAI_API_KEY, or
# OPENROUTER_API_KEY must be set.
# If multiple are set, the priority is:
# ANTHROPIC_API_KEY > OPENROUTER_API_KEY > OPENAI_API_KEY
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenRouter (https://openrouter.ai) — single API key for 100+ models.
# Get a key at https://openrouter.ai/keys
# Then set OPENROUTER_API_KEY=sk-or-v1-...
# Optionally pin the model via LLM_MODEL=anthropic/claude-sonnet-4
OPENROUTER_API_KEY=

# Optional: override the LLM provider selection.
# Values: "auto" (default, picks from env), "anthropic", "openai"
LLM_PROVIDER=auto

# Optional: override the model name (provider-specific).
# Examples: claude-sonnet-5, gpt-4o, gpt-4o-mini
LLM_MODEL=

# ─── Neo4j (knowledge graph) ───────────────────────────────────────────
# Used by the kg_build task to write to a real Neo4j instance.
# If not set, the kgpipeline falls back to SQLite (the default).
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword

# ─── Auth for Neo4j inside the compose network ────────────────────────
# Same value as NEO4J_PASSWORD but in Neo4j's expected format.
NEO4J_AUTH=neo4j/devpassword

# ─── Web server config ──────────────────────────────────────────────────
DPO_AGENT_LOG_LEVEL=info
# Comma-separated list of allowed CORS origins, or * for any.
# In production, replace * with your domain (e.g. https://dpo.example.com).
DPO_AGENT_CORS_ORIGINS=*
